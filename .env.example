# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL
FRONTEND_URL=http://localhost:5173 

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Database (optional - for future persistence)
DATABASE_URL=sqlite:///./provider_validation.db

# Twilio Configuration (for SMS verification)
TWILIO_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Demo Mode (set to 'true' to skip actual SMS sending for hackathon demos)
DEMO_MODE=true

# Demo/Testing Phone Number
# IMPORTANT: All SMS and calls will be sent to this number during testing
# This is for safety - provider phone numbers are ignored in demo mode
NOTIFY_TO=+your_phone_number_here
NOTIFY_ACTION=sms
NOTIFY_MESSAGE=

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,xlsx

# Processing Settings
BATCH_TIMEOUT=300  # seconds
MAX_WORKERS=4

# Logging
LOG_LEVEL=INFO
